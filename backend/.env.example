# ============================================
# BACKEND — Comercial Uruguay
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================

# --- Servidor ---
# (Obligatorio) Puerto en el que corre la API.
# En desarrollo: 5000
# En producción (Render): Render asigna el puerto automáticamente.
PORT=5000

# --- Base de Datos (Supabase) ---
# (Obligatorio) Cadena de conexión a PostgreSQL.
# Formato: postgresql://usuario:password@host:puerto/nombre_db
# Se obtiene en Supabase → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://usuario:password@host:5432/comercial_uruguay

# --- Autenticación ---
# (Obligatorio) Clave secreta para firmar los tokens JWT.
# Debe ser una cadena larga y aleatoria.
# Generar con: openssl rand -base64 32
JWT_SECRET=cambia_esto_por_una_clave_larga_y_segura

# --- Servicio de Email (Resend) ---
# (Obligatorio) API Key de Resend para enviar correos.
# Obtén una en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# (Obligatorio) Dirección "from" que verán los destinatarios.
# En desarrollo: onboarding@resend.dev (dominio de pruebas de Resend).
# En producción: un email de tu dominio verificado en Resend.
EMAIL_FROM=onboarding@resend.dev

# --- Frontend (CORS) ---
# (Obligatorio) URL del frontend para permitir peticiones CORS.
# En desarrollo: http://localhost:5173
# En producción: https://comercial-uruguay.vercel.app
FRONTEND_URL=http://localhost:5173