# ============================================
# FRONTEND — Comercial Uruguay (Vite)
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================

# --- API Backend ---
# (Obligatorio) URL base de la API del backend.
# En desarrollo: http://localhost:5000/api
# En producción: https://comercial-uruguay-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# --- Supabase (Público) ---
# (Obligatorio) URL del proyecto Supabase.
# Visible en el navegador. No es un secreto.
# Se obtiene en Supabase → Project Settings → API → Project URL.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# (Obligatorio) Clave anónima de Supabase.
# Visible en el navegador. Está diseñada para ser pública.
# Se obtiene en Supabase → Project Settings → API → anon public.
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_publica